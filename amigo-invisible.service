[Unit]
Description=Liga Cognatis - Amigo Invisible y Sorteo de Equipos
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aperezh
Group=aperezh
WorkingDirectory=/home/aperezh/Projects/secret-santa-checker
EnvironmentFile=-/home/aperezh/Projects/secret-santa-checker/.env
ExecStart=/home/aperezh/Projects/secret-santa-checker/.venv/bin/gunicorn app:app --bind 0.0.0.0:8080 --workers 2 --timeout 30
Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=15s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=amigo-invisible

[Install]
WantedBy=multi-user.target
